    "/api/payments/checkout": {
      "post": {
        "summary": "Create a Kashier checkout session",
        "description": "Creates a pending order in the database and returns a Kashier checkout URL for the user to complete payment.",
        "tags": ["Payments"],
        "security": [{"bearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["packageId"],
                "properties": {
                  "packageId": {
                    "type": "string",
                    "example": "64a2f9b8c3f4e2a1b2c3d4e5"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Checkout session created — returns checkoutUrl",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {"type": "string", "example": "Checkout session created successfully"},
                    "checkoutUrl": {"type": "string", "example": "https://checkout.kashier.io/?merchantId=..."},
                    "orderId": {"type": "string"},
                    "kashierOrderId": {"type": "string"}
                  }
                }
              }
            }
          },
          "400": {"description": "Package not found or already purchased"},
          "401": {"description": "Unauthorized"}
        }
      }
    },
    "/api/webhooks/kashier": {
      "post": {
        "summary": "Kashier payment webhook (server-to-server)",
        "description": "Called by Kashier after a payment is processed. Verifies the HMAC signature using the signatureKeys array, then activates the user's subscription. **Do NOT call this manually — it is server-to-server only.**",
        "tags": ["Payments"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "platform": {"type": "string", "example": "kashier"},
                  "event": {"type": "string", "example": "pay"},
                  "data": {
                    "type": "object",
                    "properties": {
                      "merchantOrderId": {"type": "string"},
                      "kashierOrderId": {"type": "string"},
                      "status": {"type": "string", "example": "SUCCESS"},
                      "amount": {"type": "number", "example": 100},
                      "currency": {"type": "string", "example": "EGP"},
                      "transactionId": {"type": "string"},
                      "cardToken": {"type": "string"},
                      "signatureKeys": {
                        "type": "array",
                        "items": {"type": "string"},
                        "description": "Fields used by Kashier to compute the HMAC signature"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "x-kashier-signature",
            "schema": {"type": "string"},
            "description": "HMAC-SHA256 signature sent by Kashier"
          }
        ],
        "responses": {
          "200": {"description": "Webhook processed successfully"},
          "403": {"description": "Invalid HMAC signature"},
          "404": {"description": "Order not found"}
        }
      }
    },
    "/api/payments/renew": {
